# Environment Variable Structure for MindGuard AI Companion (Week 3 Foundations)
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# API Base URL for backend services & health checks
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Application Environment (development, preview, production)
NEXT_PUBLIC_APP_ENV=development

# LLM Provider Configuration (Server-side only — never expose to client bundle)
# Note: Keep placeholder in .env.example, provide real key in Vercel project environment variables
LLM_API_KEY=sk-ant-api-placeholder-secret-key-do-not-commit

# Optional LLM Model Selector
LLM_MODEL=claude-3-5-sonnet-20241022

# Telemetry and Health Service Configurations
NEXT_PUBLIC_ENABLE_TELEMETRY=true
NEXT_PUBLIC_APP_VERSION=1.0.0-alpha
